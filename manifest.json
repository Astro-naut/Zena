{
  "manifest_version": 3,
  "name": "Zena — YouTube Focus",
  "version": "1.0.0",
  "description": "Remove YouTube distractions your way. Toggle homepage recommendations, sidebar suggestions, Shorts, comments, autoplay and more — each one on or off, independently.",
  "author": "Zena",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Zena"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zena@extension.local",
      "strict_min_version": "109.0"
    }
  }
}
